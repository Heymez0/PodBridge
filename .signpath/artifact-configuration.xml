<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration for PodBridge. Paste it as the project's default artifact configuration.
     The workflow uploads PodBridge.exe as a GitHub artifact, which arrives as a zip with the exe at its root.
     Product name and product version are enforced: only a PodBridge build whose version matches the
     "version" parameter the workflow sends (the <Version> in PodBridge.csproj) can be signed. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="PodBridge.exe" product-name="PodBridge" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
